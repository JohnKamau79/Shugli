// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Employer
  Applicant
  Worker
  Customer
}

enum Gender {
  Male
  Female
  Other
}

enum JobType {
  Remote
  Onsite
  Hybrid
}

enum Status {
  Pending
  Shortlisted
  Rejected
}

model Users {
  id            Int            @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String         @unique
  phone         String         @unique
  passwordHash  String
  gender        Gender
  role          Role
  skills        Skills[]
  cityId        Int
  city          City           @relation(fields: [cityId], references: [id])
  isPremium     Boolean        @default(false)
  premiumExpiry DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobs          Jobs[]
  workerProfile WorkerProfile?
  applications  Application[]
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  jobs           Jobs[]
  workerProfiles WorkerProfile[]
}

model City {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  jobs  Jobs[]
  users Users[]
}

model Jobs {
  id           Int           @id @default(autoincrement())
  title        String
  jobType      JobType
  description  String
  cityId       Int
  city         City          @relation(fields: [cityId], references: [id])
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  salary       Int?
  userId       Int
  employer     Users         @relation(fields: [userId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expiresAt    DateTime?
  applications Application[]
}

model Skills {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]
}

model WorkerProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       Users    @relation(fields: [userId], references: [id])
  headline   String
  bio        String
  yoe        Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Application {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      Users    @relation(fields: [userId], references: [id])
  jobId     Int
  job       Jobs     @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())
  status    Status   @default(Pending)

  @@unique([userId, jobId])
}
