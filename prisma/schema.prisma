// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Employer
  Applicant
  Worker
  Customer
}

enum Gender {
  Male
  Female
  Other
}

enum JobType {
  Remote
  Onsite
  Hybrid
}

enum Duration {
  Full_Time
  Contract
  Part_Time
  Internship
  Casual
}

enum Status {
  Pending
  Shortlisted
  Rejected
}

enum EducationLevel {
  Certificate
  Diploma
  Bachelors_BSc_BA
  Masters_MSc_MA
  Doctorate_PHD
}

model Users {
  id               Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  email            String            @unique
  phone            String            @unique
  passwordHash     String
  gender           Gender
  role             Role
  skills           Skills[]
  cityId           Int
  city             City              @relation(fields: [cityId], references: [id])
  isPremium        Boolean           @default(false)
  premiumExpiry    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobs             Jobs[]
  workerProfile    WorkerProfile?
  applications     Application[]
  workExperiences  WorkExperience[]
  workerEducations WorkerEducation[]
  languages        Languages[]
  // professionalSummaries ProfessionalSummary[]
}

model Category {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  description    String
  jobs           Jobs[]
  workerProfiles WorkerProfile[]
}

model City {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  jobs            Jobs[]
  users           Users[]
  workExperiences WorkExperience[]
}

model Jobs {
  id           Int           @id @default(autoincrement())
  title        String
  jobType      JobType
  duration     Duration
  description  String
  company      String
  cityId       Int
  city         City          @relation(fields: [cityId], references: [id])
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  salary       Int?
  userId       Int
  employer     Users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expiresAt    DateTime?
  applications Application[]
}

model Skills {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]
}

model WorkerProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline   String
  bio        String
  yoe        Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WorkExperience {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle     String
  company      String
  doEntry      DateTime
  doExit       DateTime?
  cityId       Int
  city         City      @relation(fields: [cityId], references: [id])
  skills       String[]
  achievements String[]
}

model WorkerEducation {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute String
  level     EducationLevel
  course    String
  doEntry   DateTime
  doExit    DateTime?
}

// model ProfessionalSummary {
//   id      Int    @id @default(autoincrement())
//   summary String
//   userId  Int
//   user    Users  @relation(fields: [userId], references: [id])
// }

model Languages {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]
}

model Application {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     Int
  job       Jobs     @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())
  status    Status   @default(Pending)

  @@unique([userId, jobId])
}
